{
  "name": "assinatura-digital-frontend",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "ngc --noEmit",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint src --ext .ts,.html --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input --max-warnings 0",
    "lint:fix": "npm run lint:code -- --fix && npm run lint:styles -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tests/signature-flow.cjs && node tests/pki-platform.cjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "web-pki": "^2.18.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/types": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "typescript": "~6.0.3"
  }
}
